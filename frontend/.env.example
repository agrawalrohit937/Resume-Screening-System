# ═══════════════════════════════════════════════════════════════════════════════
# CareerShala Frontend — Environment Configuration (.env.example)
# In local development, you do NOT even need a .env file!
# Vite's dev server automatically proxies /api/v1 -> http://localhost:8000
# ═══════════════════════════════════════════════════════════════════════════════

# Optional locally: Override backend API base endpoint (default is /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Optional: OAuth 2.0 Client IDs for Social Sign-in
# Safe for frontend exposure (public client IDs only)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=your-github-client-id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/github-callback
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id
VITE_LINKEDIN_REDIRECT_URI=http://localhost:5173/linkedin-callback

