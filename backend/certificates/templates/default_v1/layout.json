{
  "background": "base_cert.pdf",

  "fonts": {
    "script": {
      "alias": "CertScript",
      "file": "GreatVibes-Regular.ttf",
      "fallback": "Helvetica-Bold"
    },
    "body": {
      "alias": "CertBody",
      "file": "Montserrat-Regular.ttf",
      "fallback": "Helvetica"
    },
    "body_semibold": {
      "alias": "CertBodySemibold",
      "file": "Lora-Bold.ttf",
      "fallback": "Helvetica-Bold"
    }
  },

  "text_fields": {

    "recipient_name": {
      "x_frac": 0.489,
      "y_frac": 0.587,
      "font": "script",
      "size": 38,
      "color": "#1E293B",
      "align": "center"
    },

    "assessment_name": {
      "x_frac": 0.504,
      "y_frac": 0.498,
      "font": "body_semibold",
      "size": 16,
      "color": "#1e293b",
      "align": "center",
      "max_width_frac": 0.62,
      "min_size": 10
    },

    "level": {
      "x_frac": 0.50,
      "y_frac": 0.380,
      "font": "body",
      "size": 11,
      "color": "#94a3b8",
      "align": "center"
    },
    "skill_name": {
      "x_frac": 0.143,
