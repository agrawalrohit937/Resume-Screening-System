      "size": 8,
      "color": "#64748b",
      "align": "center"
    },

    "cert_id": {
      "x_frac": 0.286,
      "y_frac": 0.042,
      "font": "body",
      "size": 8,
      "color": "#64748b",
      "align": "center"
    }
  },

  "image_fields": {
    "skill_logo": {
        "x_frac": 0.076,
