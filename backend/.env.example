# ═══════════════════════════════════════════════════════════════════════════════
# CareerShala Backend — Environment Configuration Template (.env.example)
# Quick Start: Simply copy this file to .env (cp .env.example .env)
# 
# NOTE: The platform is built with 2-tier graceful fallbacks:
# - ONLY MongoDB (MONGO_URI) is required to run the platform locally.
# - If AI keys (Groq/Gemini) are absent, the system gracefully uses local
#   neural embeddings (BGE-M3) and built-in template mock engines.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. Application & URLs ───────────────────────────────────────────────────
APP_NAME="CareerShala — AI ATS & Talent Cloud"
APP_VERSION="3.0.0"
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_URL="http://localhost:5173"

# ─── 2. Database (MongoDB) [REQUIRED] ─────────────────────────────────────────
# Local MongoDB: mongodb://localhost:27017 or free MongoDB Atlas cluster URI
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="ai_career_platform"
MONGO_MAX_CONNECTIONS=100
MONGO_MIN_CONNECTIONS=10

# ─── 3. Security & JWT [PRE-CONFIGURED FOR LOCAL DEV] ────────────────────────
# Pre-configured 64-char development key. Change in production.
SECRET_KEY="careershala_dev_jwt_secret_key_change_in_production_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REQUIRE_OTP_FOR_NEW_DEVICE=false

# ─── 4. CORS [PRE-CONFIGURED] ────────────────────────────────────────────────
ALLOWED_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# ─── 5. Cache & Background Task Workers (Redis / Celery) [OPTIONAL] ──────────
# If Redis is not running, FastAPI uses built-in in-memory caching automatically.
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ─── 6. AI & LLM Provider Keys [OPTIONAL — Auto-falls back if omitted] ───────
# Get a free key at https://console.groq.com
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""

# Get a free key at https://aistudio.google.com
GOOGLE_API_KEY_1=""
GOOGLE_API_KEY_2=""
GOOGLE_API_KEY_3=""
GOOGLE_API_KEY_4=""
GOOGLE_API_KEY_5=""

# Mistral AI (Optional fallback for text embeddings / inference)
MISTRAL_API_KEY="your-mistral-api-key"

# HuggingFace Token (For open-source model inference & downloads)
HF_TOKEN="hf_your_huggingface_token"

# Optional Secondary LLM Providers
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# ─── 7. Document Intelligence (OCR / Deep Parsing) ───────────────────────────
AZURE_DI_ENDPOINT="https://your-cognitiveservices.azure.com/"
AZURE_DI_KEY="your-azure-document-intelligence-key"

# ─── 8. OAuth2 Providers ─────────────────────────────────────────────────────
# Google OAuth & Gmail Offline Access (gmail.send scope)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:5173/gmail-callback"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:5173/linkedin-callback"

# GitHub OAuth & Integration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:5173/github-callback"
GITHUB_TOKEN=""
GITHUB_API_BASE="https://api.github.com"

# ─── 9. File Upload & Cloudinary Storage ─────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ─── 10. Email Communications (Brevo API & System Mailboxes) ─────────────────
BREVO_API_KEY="xkeysib-your-brevo-api-key"
MAIL_FROM_EMAIL="noreply@careerpilot.tech"
MAIL_FROM_NAME="CareerPilot"
ADMIN_EMAIL="admin@careerpilot.tech"
SUPPORT_EMAIL="support@careerpilot.tech"
CAREERS_EMAIL="careers@careerpilot.tech"
INFO_EMAIL="info@careerpilot.tech"

# ─── 11. Payment Gateway (Razorpay) ──────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
